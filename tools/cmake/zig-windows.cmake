set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR AMD64)
set(CCR_ZIG_EXECUTABLE "" CACHE FILEPATH "Path to the portable Zig executable")
if(NOT EXISTS "${CCR_ZIG_EXECUTABLE}")
  message(FATAL_ERROR "Set CCR_ZIG_EXECUTABLE to the downloaded Zig executable")
endif()

list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES CCR_ZIG_EXECUTABLE)
set(CMAKE_C_COMPILER "${CCR_ZIG_EXECUTABLE}")
set(CMAKE_C_COMPILER_ARG1 cc)
set(CMAKE_CXX_COMPILER "${CCR_ZIG_EXECUTABLE}")
set(CMAKE_CXX_COMPILER_ARG1 "c++")
set(CMAKE_C_FLAGS_INIT "-target x86_64-windows-gnu")
set(CMAKE_CXX_FLAGS_INIT "-target x86_64-windows-gnu")
set(CMAKE_AR "${CCR_ZIG_EXECUTABLE}")
set(CMAKE_C_ARCHIVE_CREATE "\"${CCR_ZIG_EXECUTABLE}\" ar qc <TARGET> <LINK_FLAGS> <OBJECTS>")
set(CMAKE_CXX_ARCHIVE_CREATE "${CMAKE_C_ARCHIVE_CREATE}")
set(CMAKE_C_ARCHIVE_FINISH "")
set(CMAKE_CXX_ARCHIVE_FINISH "")
set(CMAKE_C_CREATE_STATIC_LIBRARY "\"${CCR_ZIG_EXECUTABLE}\" ar qc <TARGET> <OBJECTS>")
set(CMAKE_CXX_CREATE_STATIC_LIBRARY "${CMAKE_C_CREATE_STATIC_LIBRARY}")

# Use Zig's resource compiler with the bundled MinGW headers for SDL's resources.
set(CMAKE_RC_COMPILER "${CCR_ZIG_EXECUTABLE}")
set(CMAKE_RC_COMPILER_ARG1 rc)
set(CMAKE_RC_COMPILE_OBJECT "\"${CCR_ZIG_EXECUTABLE}\" rc /:auto-includes gnu /:output-format coff /:target x86_64 <DEFINES> <INCLUDES> <FLAGS> /fo <OBJECT> <SOURCE>")
